<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>

	<ItemGroup>
		<PackageVersion Include="MediatR" Version="14.2.0" />
		<PackageVersion Include="NetTopologySuite" Version="2.6.0" />
		<PackageVersion Include="MailKit" Version="4.18.1" />
		<PackageVersion Include="Twilio" Version="8.1.0" />
		<PackageVersion Include="QuestPDF" Version="2026.9.0" />
		<PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
	</ItemGroup>

	<ItemGroup Label="ASP.NET Core and EF Core (keep on the same patch version)">
		<PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
		<PackageVersion Include="Microsoft.AspNetCore.Authorization" Version="10.0.14" />
		<PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.14" />
		<PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
		<PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer.NetTopologySuite" Version="10.0.14" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.10.0" />
	</ItemGroup>

	<ItemGroup Label="Logging, API and observability">
		<PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
		<PackageVersion Include="Asp.Versioning.Mvc" Version="10.2.1" />
		<PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
		<PackageVersion Include="Scalar.AspNetCore" Version="2.18.2" />
		<PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
		<PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.1-beta.1" />
		<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
	</ItemGroup>

	<ItemGroup>
		<!--><PackageVersion Include="StyleCop.Analyzers" Version="1.3.151-beta"/> -->
		<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<PackageVersion Include="xunit" Version="2.9.3" />
		<PackageVersion Include="NSubstitute" Version="5.1.0" />
		<PackageVersion Include="coverlet.collector" Version="6.0.4" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
		<PackageVersion Include="Azure.Core" Version="1.64.0" />
	</ItemGroup>

</Project>
